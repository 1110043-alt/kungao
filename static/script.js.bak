async function loadNews() {
    console.log("Loading news...");
    try {
        const response = await fetch('/api/news', { cache: 'no-store' });
        if (!response.ok) throw new Error('Failed to load news');
        
        const newsData = await response.json();
        const newsContainer = document.getElementById("newsContainer");
        if (!newsContainer) {
            console.error("News container not found");
            return;
        }
        
        let html = '<div style="display: grid; gap: 16px;">';
        
        newsData.forEach(item => {
            const impactEmoji = item.impact === 'positive' ? '??' : (item.impact === 'negative' ? '??' : '?��?');
            
            html += '<div style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; background: white;">';
            html += '<div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">';
            html += '<div>';
            html += '<h3 style="margin: 0 0 4px 0; color: #1f2937;">' + item.title + '</h3>';
            html += '<div style="font-size: 12px; color: #6b7280;">' + item.date + ' ??' + item.category + '</div>';
            html += '</div>';
            html += '<span style="font-size: 20px;">' + impactEmoji + '</span>';
            html += '</div>';
            html += '<p style="margin: 8px 0 0 0; color: #4b5563; font-size: 14px;">' + item.description + '</p>';
            html += '</div>';
        });
        
        html += '</div>';
        newsContainer.innerHTML = html;
        
    } catch (error) {
        console.error("Error loading news:", error);
        const newsContainer = document.getElementById("newsContainer");
        if (newsContainer) {
            newsContainer.innerHTML = '<div style="color: red; padding: 20px;">?��??��??��?資�?</div>';
        }
    }
}

// K線�?表�???
async function loadKlineChart(code) {
    console.log("Loading K-line chart for:", code);
    try {
        const response = await fetch('/api/stock-history/' + code, { cache: 'no-store' });
        if (!response.ok) throw new Error('Failed to load stock history');
        
        const historyData = await response.json();
        const klinePanel = document.getElementById("klineChartPanel");
        if (!klinePanel) return;
        
        if (!historyData.dates || historyData.dates.length === 0) {
            klinePanel.style.display = 'none';
            return;
        }
        
        klinePanel.style.display = 'block';
        const canvas = document.getElementById("klineChart");
        if (!canvas) return;
        
        if (window.klineChart && typeof window.klineChart.destroy === 'function') {
            window.klineChart.destroy();
        }
        
        window.klineChart = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: historyData.dates,
                datasets: [{
                    label: '?�票?�格',
                    data: historyData.closes,
                    borderColor: '#7c3aed',
                    backgroundColor: historyData.closes.map(function(c, i) {
                        if (i === 0) return '#7c3aed';
                        return c >= historyData.closes[i-1] ? '#ef4444' : '#10b981';
                    }),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: false, ticks: { color: '#6b7280' }, grid: { color: '#e5e7eb' } },
                    x: { ticks: { color: '#6b7280', maxRotation: 45, minRotation: 0 }, grid: { color: '#e5e7eb' } }
                }
            }
        });
        
    } catch (error) {
        console.error("Error loading K-line:", error);
    }
}
