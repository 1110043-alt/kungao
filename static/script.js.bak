let currentChart = null;
let marketChart = null;
let stocks = {};
const prevPrices = {};
const MARKET_REFRESH_MS = 10000;

document.addEventListener("DOMContentLoaded", () => {
    console.log("=== DOMContentLoaded fired ===");
    setupTabs();
    setupSelectors();
    setupActionButtons();
    document.getElementById("refreshBtn")?.addEventListener("click", () => refreshDashboard(true));
    
    // Initialize: Load all data once
    (async () => {
        try {
            console.log("Starting initial data load...");
            const [allStocks, topStocks] = await Promise.all([
                fetchJson("/api/all-stocks"),
                fetchJson("/api/top-stocks"),
            ]);
            console.log("??Data fetched:", { allStocks: allStocks.length, topStocks: topStocks.length });
            
            cacheStocks(allStocks);
            renderStockGrid(allStocks);
            console.log("??Stock grid rendered");
            
            renderTopStocks(topStocks);
            console.log("??Top stocks rendered");
            
            updateSummaryStats(allStocks, topStocks);
            updateSelectors(allStocks);
            setLastUpdate(allStocks);
        } catch (error) {
            console.error("Initial load failed:", error);
        }
    })();
    
    setupMarketRefresh();
    updateMarketState();
    setInterval(updateMarketState, 1000);
});

function isMarketHours() {
    const now = new Date();
    const taipei = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Taipei" }));
    const day = taipei.getDay();
    const hours = taipei.getHours();
    const minutes = taipei.getMinutes();
    const weekday = day >= 1 && day <= 5;
    const trading = (hours > 9 || (hours === 9 && minutes >= 0)) && (hours < 13 || (hours === 13 && minutes <= 30));
    return weekday && trading;
}

function formatTaipeiTime(date = new Date()) {
    return date.toLocaleTimeString("zh-TW", {
        timeZone: "Asia/Taipei",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false
    });
}

function updateSummaryStats(allStocks, topStocks) {
    let upCount = 0;
    let downCount = 0;
    
    allStocks.forEach(stock => {
        const pct = Number(stock.analysis?.day_change_pct || stock.day_change_pct || 0);
        if (pct > 0) upCount++;
        else if (pct < 0) downCount++;
    });

    let bestStockName = "--";
    if (topStocks && topStocks.length > 0) {
        const topStock = topStocks[0];
        const pct = Number(topStock.day_change_pct || topStock.analysis?.day_change_pct || 0);
        bestStockName = topStock.name + " (" + (pct >= 0 ? "+" : "") + pct.toFixed(2) + "%)";
    }

    const summaryStats = document.querySelector(".summary-stats");
    if (summaryStats) {
        const statDivs = summaryStats.querySelectorAll("div");
        if (statDivs.length >= 3) {
            // ?�新每�?div 中�? <strong> 標籤
            const upStrong = statDivs[0].querySelector("strong");
            const downStrong = statDivs[1].querySelector("strong");
            const bestStrong = statDivs[2].querySelector("strong");
            
            if (upStrong) upStrong.textContent = upCount + " �?;
            if (downStrong) downStrong.textContent = downCount + " �?;
            if (bestStrong) bestStrong.textContent = bestStockName;
        }
    }

    const summaryMain = document.querySelector(".summary-main strong");
    if (summaryMain) {
        const totalGain = upCount + downCount;
        summaryMain.textContent = totalGain > 0 ? upCount + " 檔�?�? : "?��?�?;
    }
}

async function fetchJson(url) {
    const response = await fetch(url, { cache: "no-store" });
    if (!response.ok) {
        throw new Error(url + " HTTP " + response.status);
    }
    return response.json();
}

function cacheStocks(data) {
    data.forEach((stock) => {
        stocks[stock.code] = stock;
    });
}

function setLastUpdate(data) {
    const el = document.getElementById("lastUpdate");
    if (!el) return;
    const latest = data.reduce((max, item) => Math.max(max, item.last_update || 0), 0);
    const date = latest ? new Date(latest * 1000) : new Date();
    el.dataset.fixed = "1";
    el.textContent = "?�後更??" + formatTaipeiTime(date);
}

function setupTabs() {
    document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => showTab(btn.dataset.tab, btn));
    });
}

function showTab(tabName, button) {
    document.querySelectorAll(".tab-content").forEach((el) => {
        el.classList.toggle("hidden", el.id !== tabName);
        el.classList.toggle("active", el.id === tabName);
    });
    document.querySelectorAll(".tab-btn").forEach((el) => el.classList.remove("active"));
    button?.classList.add("active");

    if (tabName === "market") loadMarketChart();
    if (tabName === "analysis") {
        const selected = document.getElementById("detailStockSelect")?.value;
        if (selected) loadDetailedAnalysis(selected);
    }
    if (tabName === "news") loadNews();
}

function setupSelectors() {
    document.getElementById("detailStockSelect")?.addEventListener("change", (e) => {
        if (e.target.value) loadDetailedAnalysis(e.target.value);
    });
    document.getElementById("analyzerStockSelect")?.addEventListener("change", () => {
        if (typeof loadAnalyzerData === "function") loadAnalyzerData();
    });
}

function updateStockPrices(data) {
    data.forEach(stock => {
        const card = document.querySelector('[data-code="' + stock.code + '"]');
        if (!card) return;
        
        const analysis = stock.analysis || {};
        const price = Number(analysis.current_price || 0);
        const pct = Number(analysis.day_change_pct || 0);
        
        const divs = card.querySelectorAll('div');
        // Find price and percentage text elements and update
        const elements = card.querySelectorAll('[data-price], [data-pct]');
        elements.forEach(el => {
            if (el.dataset.price) el.textContent = "NT$" + price.toFixed(2);
            if (el.dataset.pct) el.textContent = (pct >= 0 ? "??+" : "??") + pct.toFixed(2) + "%";
        });
    });
}

function renderStockGrid(data) {
    console.log("renderStockGrid called with", data.length, "stocks");
    const container = document.getElementById("stockGrid");
    if (!container) return;
    
    if (!Array.isArray(data) || data.length === 0) {
        container.innerHTML = '<div style="padding: 20px; text-align: center;">載入�?..</div>';
        return;
    }

    let html = "";
    data.forEach(stock => {
        const price = Number(stock.current_price || 0);
        const pct = Number(stock.day_change_pct || 0);
        const up = pct >= 0;
        
        html += '<div class="stock-card" data-code="' + stock.code + '" style="padding: 16px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(168, 85, 247, 0.06)); border: 1px solid #e9d5ff; border-radius: 8px; transition: all 0.2s; cursor: pointer;" onmouseover="this.style.boxShadow=\'0 4px 12px rgba(124, 58, 237, 0.2)\';" onmouseout="this.style.boxShadow=\'none\';">';
        html += '<div style="font-weight: 800; color: #2d1b69; margin-bottom: 8px;">' + stock.name + '</div>';
        html += '<div style="font-size: 18px; font-weight: 800; color: #2d1b69; font-family: monospace; margin-bottom: 4px;" data-price>NT$' + price.toFixed(2) + '</div>';
        html += '<div style="font-size: 14px; font-weight: 700; color: ' + (up ? '#ef4444' : '#10b981') + '; font-family: monospace;" data-pct>' + (up ? "??+" : "??") + pct.toFixed(2) + '%</div>';
        html += '</div>';
    });
    
    container.innerHTML = html;
    
    // ?��??�卡?�添?��??��?件監?�器
    document.querySelectorAll('.stock-card').forEach(card => {
        card.addEventListener('click', function() {
            const code = this.getAttribute('data-code');
            const selectEl = document.getElementById('detailStockSelect');
            if (selectEl && code) {
                selectEl.value = code;
                const analysisBtn = document.querySelector('[data-tab="analysis"]');
                showTab('analysis', analysisBtn);
                setTimeout(() => loadDetailedAnalysis(code), 100);
            }
        });
    });
}

