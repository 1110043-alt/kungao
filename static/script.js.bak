function renderSignals() {
    const selectEl = document.getElementById("analyzerStockSelect");
    const output = document.getElementById("signalsResult");
    
    if (!output || !selectEl.value) {
        if (output) output.innerHTML = '<div style="padding: 20px; color: red;">請�??��??�票</div>';
        return;
    }
    
    const code = selectEl.value;
    const stock = stocks[code];
    if (!stock) {
        output.innerHTML = '<div style="padding: 20px; color: red;">?��??�股票數??/div>';
        return;
    }
    
    // ?��??�術信??
    const rsi = stock.rsi || 50;
    const price = stock.current_price || 0;
    const ma20 = stock.ma20 || 0;
    const ma50 = stock.ma50 || 0;
    const ma200 = stock.ma200 || 0;
    const support = stock.support || 0;
    const resistance = stock.resistance || 0;
    
    let signals = [];
    let signalScore = 0;
    
    // RSI 訊�?
    if (rsi < 30) {
        signals.push({ icon: '?��', text: 'RSI 超賣 (< 30)：強?�買?��???, weight: 3 });
        signalScore += 3;
    } else if (rsi < 50) {
        signals.push({ icon: '?��', text: 'RSI 低�? (30-50)：溫?�買?��???, weight: 2 });
        signalScore += 2;
    } else if (rsi > 70) {
        signals.push({ icon: '?��', text: 'RSI 超買 (> 70)：強?�賣?��???, weight: -3 });
        signalScore -= 3;
    } else if (rsi > 50) {
        signals.push({ icon: '?��', text: 'RSI 高�? (50-70)：溫?�賣?��???, weight: -2 });
        signalScore -= 2;
    }
    
    // ?��?訊�?
    if (price > ma20 && price > ma50) {
        signals.push({ icon: '?��', text: '?�價??MA20/MA50 上方：短中�?上�?', weight: 2 });
        signalScore += 2;
    } else if (price < ma20 && price < ma50) {
        signals.push({ icon: '?��', text: '?�價??MA20/MA50 下方：短中�?下�?', weight: -2 });
        signalScore -= 2;
    }
    
    if (ma200 > 0 && price > ma200) {
        signals.push({ icon: '?��', text: '?�價??MA200 上方：長?�趨?��?�?, weight: 1 });
        signalScore += 1;
    } else if (ma200 > 0 && price < ma200) {
        signals.push({ icon: '?��', text: '?�價??MA200 下方：長?�趨?��?�?, weight: -1 });
        signalScore -= 1;
    }
    
    // ?��??��?訊�?
    if (support > 0) {
        const distToSupport = ((price - support) / support) * 100;
        if (distToSupport < 3) {
            signals.push({ icon: '?��?', text: '?��??��?�?(' + distToSupport.toFixed(2) + '%)：�?彈�???, weight: 2 });
            signalScore += 2;
        }
    }
    
    if (resistance > 0) {
        const distToResistance = ((resistance - price) / price) * 100;
        if (distToResistance < 3) {
            signals.push({ icon: '?��?', text: '?��??��?�?(' + distToResistance.toFixed(2) + '%)：承壓可??, weight: -2 });
            signalScore -= 2;
        }
    }
    
    // 波�??��???
    const volatility = stock.volatility || 2;
    if (volatility > 3) {
        signals.push({ icon: '?��?', text: '波�??��?�?(' + volatility.toFixed(2) + '%)：風?��?�?, weight: 0 });
    }
    
    // 綜�?建議
    let overallSignal = '';
    let overallColor = '#666';
    if (signalScore >= 5) {
        overallSignal = '強�?買�???';
        overallColor = '#ef4444';
    } else if (signalScore >= 2) {
        overallSignal = '?��?買�???';
        overallColor = '#10b981';
    } else if (signalScore <= -5) {
        overallSignal = '強�?�?�� ??';
        overallColor = '#ef4444';
    } else if (signalScore <= -2) {
        overallSignal = '?��?�?�� ⬇�?';
        overallColor = '#f59e0b';
    } else {
        overallSignal = '?�股觀???��?';
        overallColor = '#f59e0b';
    }
    
    // 構建 HTML
    let html = '<div style="padding: 20px; background: #f3e8ff; border-radius: 8px;">';
    html += '<h4 style="margin-bottom: 16px; color: #2d1b69;">?�術�??��???/h4>';
    
    // 綜�?評�?
    html += '<div style="padding: 16px; background: ' + overallColor + '20; border-left: 4px solid ' + overallColor + '; border-radius: 6px; margin-bottom: 16px;">';
    html += '<div style="font-size: 14px; color: #999; margin-bottom: 6px;">綜�?訊�?</div>';
    html += '<div style="font-size: 24px; font-weight: bold; color: ' + overallColor + ';">' + overallSignal + '</div>';
    html += '<div style="font-size: 12px; color: ' + overallColor + '; margin-top: 6px;">訊�?強度: ' + (signalScore >= 0 ? '+' : '') + signalScore + '</div>';
    html += '</div>';
    
    // ?�別訊�?
    html += '<div style="display: flex; flex-direction: column; gap: 8px;">';
    signals.forEach(signal => {
        html += '<div style="padding: 10px; background: white; border-radius: 6px; display: flex; align-items: center; gap: 12px; border-left: 3px solid #7c3aed;">';
        html += '<span style="font-size: 18px;">' + signal.icon + '</span>';
        html += '<span style="color: #333; font-size: 14px;">' + signal.text + '</span>';
        html += '</div>';
    });
    html += '</div>';
    
    html += '</div>';
    output.innerHTML = html;
}

