    html += '<div style="font-size: 12px; color: #999; margin-bottom: 4px;">?��???/div>';
    html += '<div style="font-size: 24px; font-weight: bold; color: ' + profitColor + ';">' + profitSymbol + ' ' + Math.abs(profitPct).toFixed(2) + '%</div>';
    html += '</div>';
    html += '</div>';
    html += '</div>';
    
    // 建議
    html += '<div style="padding: 12px; background: ' + adviceColor + '15; border-left: 4px solid ' + adviceColor + '; border-radius: 4px;">';
