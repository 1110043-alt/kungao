        htmlMarkup += '<div style="font-size: 14px; font-weight: 700; color: ' + (up ? '#ef4444' : '#10b981') + '; font-family: monospace;">';
        htmlMarkup += (up ? '??+' : '??') + pct.toFixed(2) + '%';
        htmlMarkup += '</div>';
        htmlMarkup += '</div>';
        htmlMarkup += '</div>';
    });
    htmlMarkup += '</div>';
    
    console.log("Setting HTML with " + topThree.length + " cards");
    container.innerHTML = htmlMarkup;
}

function setupActionButtons() {
    document.getElementById("calculateBudgetDistribution")?.addEventListener("click", () => {
        if (typeof calculateBudgetDistribution === "function") calculateBudgetDistribution();
    });
    document.getElementById("analyzeBtn")?.addEventListener("click", () => {
        if (typeof analyzeTrading === "function") analyzeTrading();
    });
    document.getElementById("getSignalsBtn")?.addEventListener("click", () => {
        if (typeof renderSignals === "function") renderSignals();
    });
    
    // ?��?要�??��???
    const newsBtn = document.querySelector('[data-tab="news"]');
    if (newsBtn) {
        newsBtn.addEventListener("click", () => loadNews());
    }
}

function updateSelectors(data) {
    ["detailStockSelect", "analyzerStockSelect"].forEach((id) => {
        const select = document.getElementById(id);
        if (!select) return;
        const current = select.value;
        select.innerHTML = '<option value="">?��??�票</option>';
        data.forEach((stock) => {
            const option = document.createElement("option");
            option.value = stock.code;
            option.textContent = stock.name + " (" + stock.code + ")";
            select.appendChild(option);
        });
        if (current) select.value = current;
    });
}

function setupMarketRefresh() {
    setInterval(() => {
        if (isMarketHours()) {
            refreshDashboard(false);
        }
    }, MARKET_REFRESH_MS);
}

function updateMarketState() {
    const el = document.getElementById("marketState");
    if (!el) return;
    const hours = isMarketHours();
    el.textContent = hours ? "?? ?�股?�盤�? : "?? ?��?";
}

function refreshDashboard(force) {
    (async () => {
        try {
            const [allStocks, topStocks] = await Promise.all([
                fetchJson("/api/all-stocks"),
                fetchJson("/api/top-stocks"),
            ]);
            updateStockPrices(allStocks);
            updateSummaryStats(allStocks, topStocks);
            setLastUpdate(allStocks);
        } catch (error) {
            console.error("Dashboard refresh failed:", error);
        }
    })();
}

function loadDetailedAnalysis(code) {
    const output = document.getElementById("analysisData");
    const chartPanel = document.getElementById("analysisChartPanel");
    const indicatorsDiv = document.getElementById("technicalIndicators");
    
    if (!output) return;
    
    const stock = stocks[code];
    if (!stock) {
        output.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">請選?�股�?/div>';
        if (chartPanel) chartPanel.style.display = 'none';
        if (indicatorsDiv) indicatorsDiv.style.display = 'none';
        return;
    }
    
    // ?�本信息?��?
    const up = stock.day_change_pct >= 0;
    let html = '<div style="padding: 20px;">';
    html += '<h4 style="margin-bottom: 16px; color: #2d1b69; font-size: 20px;">' + stock.name + ' (' + stock.code + ') - ' + stock.category + '</h4>';
    html += '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">';
    
    // ?�格?��?
    html += '<div style="padding: 16px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(168, 85, 247, 0.08)); border: 1px solid #e9d5ff; border-radius: 8px;">';
    html += '<div style="font-size: 12px; color: #666; margin-bottom: 8px;">?��??�格</div>';
    html += '<div style="font-size: 24px; font-weight: 800; color: #2d1b69; margin-bottom: 8px;">NT$' + stock.current_price.toFixed(2) + '</div>';
    html += '<div style="font-size: 14px; font-weight: 700; color: ' + (up ? '#ef4444' : '#10b981') + ';">';
    html += (up ? '??+' : '??') + stock.day_change_pct.toFixed(2) + '% (' + (stock.day_change || 0).toFixed(2) + ' ??</div>';
    html += '</div>';
    
    // 趨勢?��?
    html += '<div style="padding: 16px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(168, 85, 247, 0.08)); border: 1px solid #e9d5ff; border-radius: 8px;">';
    html += '<div style="font-size: 12px; color: #666; margin-bottom: 8px;">?��?趨勢</div>';
    html += '<div style="font-size: 16px; font-weight: 800; color: #7c3aed; margin-bottom: 4px;">' + (stock.trend || '?��?�?) + '</div>';
    html += '<div style="font-size: 12px; color: #888;">?��?術�??�判??/div>';
    html += '</div>';
    
    // 波�??�卡??
    html += '<div style="padding: 16px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(168, 85, 247, 0.08)); border: 1px solid #e9d5ff; border-radius: 8px;">';
    html += '<div style="font-size: 12px; color: #666; margin-bottom: 8px;">波�???/div>';
    html += '<div style="font-size: 20px; font-weight: 800; color: #2d1b69; margin-bottom: 4px;">' + (stock.volatility || 0).toFixed(2) + '%</div>';
    html += '<div style="font-size: 12px; color: #888;">波�?越大越容?�漲�?/div>';
    html += '</div>';
    
    html += '</div></div>';
    output.innerHTML = html;
    
    // 顯示?�表
    if (chartPanel) {
        chartPanel.style.display = 'block';
        loadAnalysisChart(code);
    }
    
    // 顯示?�術�?標說??
    if (indicatorsDiv) {
        indicatorsDiv.style.display = 'block';
        renderIndicatorExplanations(stock);
    }
    
    // ?��? K 線�?�?
    loadKlineChart(code);
}

function loadAnalysisChart(code) {
    const ctx = document.getElementById("analysisChart");
    if (!ctx) return;
    
    fetch('/api/stock-history/' + code, { cache: 'no-store' })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                ctx.parentElement.innerHTML = '<div style="padding: 20px; color: red;">?��?載入?�表</div>';
                return;
            }
            
            const parent = ctx.parentElement;
            const parentRect = parent.getBoundingClientRect();
            ctx.width = parentRect.width;
            ctx.height = 300;
            
            if (window.analysisChart && typeof window.analysisChart.destroy === 'function') {
                window.analysisChart.destroy();
            }
            
            const closes = data.closes || [];
            const dates = data.dates || [];
            
            // 計�??�小�??�大值用?�Y�?
            const minPrice = Math.min(...closes);
            const maxPrice = Math.max(...closes);
            const padding = (maxPrice - minPrice) * 0.1;
            
            window.analysisChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dates,
                    datasets: [{
                        label: '?�價',
                        data: closes,
                        borderColor: '#7c3aed',
                        backgroundColor: 'rgba(124, 58, 237, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3,
                        pointBackgroundColor: '#7c3aed',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 1,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#2d1b69', font: { size: 12 } }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#999', font: { size: 10 } },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        y: {
                            min: minPrice - padding,
                            max: maxPrice + padding,
                            ticks: { color: '#999', font: { size: 10 }, callback: function(v) { return 'NT$' + v.toFixed(0); } },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        }
                    }
                }
            });
        })
        .catch(err => {
            console.error("Chart error:", err);
            ctx.parentElement.innerHTML = '<div style="padding: 20px; color: red;">?�表載入失�?</div>';
        });
}

function renderIndicatorExplanations(stock) {
    const grid = document.getElementById("indicatorsGrid");
    if (!grid) return;
    
    const indicators = [
        {
            name: "RSI (?��?強度?�數)",
            value: (stock.rsi || 0).toFixed(2),
            unit: "??,
            explanation: "衡�??�票超買/超賣�?-30 ?�能低估�?0-100 ?�能高估",
            assessment: stock.rsi ? (stock.rsi < 30 ? "?��? (買進�???" : stock.rsi > 70 ? "?��? (�?��訊�?)" : "?�中") : "N/A"
        },
        {
            name: "MA20 (20?��?�?",
            value: "NT$" + ((stock.ma20 || 0).toFixed(2)),
            unit: "",
            explanation: "�?0天�?平�??�價，�??�短?�走??,
            assessment: stock.current_price > stock.ma20 ? "?�價高於?��? (強勢)" : "?�價低於?��? (弱勢)"
        },
        {
            name: "MA50 (50?��?�?",
            value: "NT$" + ((stock.ma50 || 0).toFixed(2)),
            unit: "",
            explanation: "�?0天�?平�??�價，�??�中?�走??,
            assessment: stock.current_price > stock.ma50 ? "?�價高於?��? (強勢)" : "?�價低於?��? (弱勢)"
        },
        {
            name: "MA200 (200?��?�?",
            value: "NT$" + ((stock.ma200 || 0).toFixed(2)),
            unit: "",
            explanation: "�?00天�?平�??�價，�??�長?�走?��??��?趨勢",
            assessment: stock.current_price > stock.ma200 ? "?�價高於?��? (?��??�漲)" : "?�價低於?��? (?��??��?)"
        },
        {
            name: "?��?�?(Support)",
            value: "NT$" + ((stock.support || 0).toFixed(2)),
            unit: "",
            explanation: "?�能?��?低�?，股票�??��??�此?��?",
            assessment: Math.abs(stock.current_price - stock.support) / stock.support < 0.05 ? "?��??��?�? : "?�離?��?�?
        },
        {
            name: "?��?�?(Resistance)",
            value: "NT$" + ((stock.resistance || 0).toFixed(2)),
            unit: "",
            explanation: "?�能?��?高�?，股票�??��??�此?��?",
            assessment: Math.abs(stock.resistance - stock.current_price) / stock.resistance < 0.05 ? "?��??��?�? : "?�離?��?�?
        }
    ];
    
    let html = '';
    indicators.forEach(ind => {
        html += '<div style="padding: 16px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(168, 85, 247, 0.06)); border: 1px solid #e9d5ff; border-radius: 8px;">';
        html += '<div style="font-weight: 700; color: #2d1b69; margin-bottom: 8px; font-size: 14px;">' + ind.name + '</div>';
        html += '<div style="font-size: 18px; font-weight: 800; color: #7c3aed; margin-bottom: 4px; font-family: monospace;">' + ind.value + '</div>';
        html += '<div style="font-size: 12px; color: #888; margin-bottom: 8px; line-height: 1.5;">' + ind.explanation + '</div>';
        html += '<div style="font-size: 12px; padding: 6px 8px; background: rgba(124, 58, 237, 0.1); border-radius: 4px; color: #7c3aed; font-weight: 600;">' + ind.assessment + '</div>';
        html += '</div>';
    });
    
    grid.innerHTML = html;
}

function loadStockChart(code) {
    const output = document.getElementById("chartContainer");
    const logs = window._stockChartLogs = window._stockChartLogs || [];
    
    if (!output) {
        logs.push("chartContainer not found");
        return;
    }
    
    logs.push("loadStockChart called with code: " + code);
    
    const ctx = document.getElementById("trendChart");
    if (!ctx) {
        logs.push("trendChart canvas not found");
        output.innerHTML = '<div style="padding: 40px; text-align: center; color: #999;">?�表?��??�找??/div>';
        return;
    }
    
    logs.push("Canvas found, fetching data...");
    
    fetch('/api/stock-history/' + code, { cache: 'no-store' })
        .then(r => {
            logs.push("API response received, status: " + r.status);
            return r.json();
        })
        .then(data => {
            logs.push("Data parsed: " + JSON.stringify({ error: data.error, hasClosesData: !!data.closes, datesLen: data.dates?.length }));
            
            if (data.error) {
                logs.push("API error: " + data.error);
                output.innerHTML = '<div style="padding: 20px; color: red;">' + data.error + '</div>';
                return;
            }
            
            logs.push("Setting canvas size...");
            
            // 设置canvas大�?
            const parent = ctx.parentElement;
            const parentRect = parent.getBoundingClientRect();
            ctx.width = parentRect.width;
            ctx.height = parentRect.height;
            
            logs.push("Canvas size: " + ctx.width + "x" + ctx.height);
            
            // ?��??��?�?
            if (window.currentChart) {
                logs.push("Destroying old currentChart");
                window.currentChart.destroy();
            }
            
            logs.push("Creating new Chart...");
            
            try {
                window.currentChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.dates,
                        datasets: [{
                            label: data.name + ' ?�價',
                            data: data.closes,
                            borderColor: '#7c3aed',
                            backgroundColor: 'rgba(124, 58, 237, 0.1)',
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 3,
                            pointBackgroundColor: '#7c3aed'
                        }]
                    },
                    options: {
                        responsive: false,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: true, labels: { color: '#2d1b69' } }
                        },
                        scales: {
                            y: {
                                ticks: { color: '#666' },
                                grid: { color: '#f0f0f0' }
                            },
                            x: {
                                ticks: { color: '#666' },
                                grid: { color: '#f0f0f0' }
                            }
                        }
                    }
                });
                logs.push("Chart created successfully! window.currentChart type: " + typeof window.currentChart);
            } catch (chartErr) {
                logs.push("Error creating chart: " + chartErr.message);
            }
        })
        .catch(err => {
            logs.push("Fetch error: " + err.message);
            output.innerHTML = '<div style="padding: 20px; color: red;">載入失�?: ' + err + '</div>';
        });
}
// 計�??��??�票?��?資�???(0-100)
function calculateStockScore(stock) {
    let score = 50; // ?��???
    
    // 1. RSI 評�?：�?�?(買�?) ?��?高�?
    const rsi = stock.rsi || 50;
    if (rsi < 30) {
        score += 20; // 超賣，買?��???
    } else if (rsi < 50) {
        score += 10; // 較�?，適?�買??
    } else if (rsi > 70) {
        score -= 15; // 超買，賣?��???
    } else {
        score += 5; // 中�?
    }
    
    // 2. ?��?趨勢評�?：股?��??��?條�?線為上�?趨勢
    const price = stock.current_price || stock.price || 0;
    let trendPoints = 0;
    if (price > (stock.ma20 || 0)) trendPoints += 5;
    if (price > (stock.ma50 || 0)) trendPoints += 5;
    if (price > (stock.ma200 || 0)) trendPoints += 5;
    score += trendPoints;
    
    // 3. ?��?位�??��??��??��?位表示�??��???
    const support = stock.support || 0;
    if (support > 0) {
        const distToSupport = ((price - support) / support) * 100;
        if (distToSupport < 5) {
            score += 15; // ?��??��?位�??��?�?
        } else if (distToSupport < 15) {
            score += 8;
        }
    }
    
    // 4. 波�??��??��??�度波�??��?(1-3%)，�?高�???
    const volatility = stock.volatility || 2;
    if (volatility >= 1 && volatility <= 3) {
        score += 10; // ?�度波�?
    } else if (volatility > 4) {
        score -= 10; // 波�??�大，風?��?
    }
    
    // 5. 漲�?評�?：�??�漲幅正?��???
    const dayChange = stock.day_change_pct || 0;
    if (dayChange > 2) {
        score += 5; // 強勢
    } else if (dayChange < -2) {
        score -= 5; // 弱勢
    }
    
    return Math.max(0, Math.min(100, score));
}

// 計�??�票風險等�?
function calculateRiskLevel(stock, score) {
    const volatility = stock.volatility || 2;
    const rsi = stock.rsi || 50;
    
    if (volatility > 4 || rsi > 75 || score < 40) {
        return { level: '高風??, emoji: '?��', color: '#ef4444' };
    } else if (volatility > 2.5 || rsi > 60 || score < 55) {
        return { level: '中風??, emoji: '?��', color: '#f59e0b' };
    } else {
        return { level: '低風??, emoji: '?��', color: '#10b981' };
    }
}

function calculateBudgetDistribution() {
    const category = document.getElementById("budgetCategory")?.value || "";
    const amount = parseFloat(document.getElementById("budgetInputAmount")?.value || 0);
    const topN = parseInt(document.getElementById("budgetTopN")?.value || 5);
    const output = document.getElementById("budgetAdviceResult");
    
    if (!output) return;
    
    if (amount < 1000) {
        output.innerHTML = '<div style="padding: 20px; color: red;">請輸?��?少�???1,000 ??/div>';
        return;
    }
    
    // ?��?類別篩選?�票
    let selectedStocks = [];
    for (const code in stocks) {
        const stock = stocks[code];
        if (!category || stock.category === category) {
            selectedStocks.push(stock);
        }
    }
    
    if (selectedStocks.length === 0) {
        output.innerHTML = '<div style="padding: 20px; color: red;">該�??�無?�用?�票</div>';
        return;
    }
    
    // 計�?評�??�風?��??��?
    selectedStocks = selectedStocks.map(stock => {
        const score = calculateStockScore(stock);
        const risk = calculateRiskLevel(stock, score);
        return { ...stock, score, risk };
    }).sort((a, b) => b.score - a.score);
    
    selectedStocks = selectedStocks.slice(0, topN);
    
    // ?��?評�??��??��?資�?
    const totalScore = selectedStocks.reduce((sum, s) => sum + s.score, 0);
    const allocations = selectedStocks.map(stock => {
        const ratio = stock.score / totalScore; // 評�?佔�?
        const allocation = Math.round(amount * ratio);
        return { ...stock, allocation, ratio };
    });
    
    // 調整?�後�?檔以確�?總�?�?��
    let totalAlloc = allocations.reduce((sum, a) => sum + a.allocation, 0);
    const remainder = amount - totalAlloc;
    if (allocations.length > 0) {
        allocations[allocations.length - 1].allocation += remainder;
    }
    
    // ?��? HTML
    let html = '<div style="padding: 20px; background: #f3e8ff; border-radius: 8px;">';
    html += '<h4 style="margin-bottom: 16px; color: #2d1b69;">?? ?�能資�??��?建議</h4>';
    
    // 概�?信息
    html += '<div style="margin-bottom: 20px; padding: 12px; background: white; border-radius: 6px;">';
    html += '<div style="font-size: 14px; color: #666; margin-bottom: 6px;">?�入總�?: <strong style="color: #2d1b69; font-size: 16px;">NT$' + amount.toLocaleString() + '</strong></div>';
    html += '<div style="font-size: 14px; color: #666;">?��?檔數: <strong style="color: #2d1b69;">' + allocations.length + ' �?/strong> | ?�於?�術�?標智?��?�?/div>';
    html += '</div>';
    
    // ?��?表格
    html += '<table style="width: 100%; border-collapse: collapse;">';
    html += '<tr style="border-bottom: 2px solid #ddd; background: #f9f5ff;">';
    html += '<th style="text-align: left; padding: 10px; color: #2d1b69;">?�票</th>';
    html += '<th style="text-align: center; padding: 10px; color: #2d1b69;">評�?</th>';
    html += '<th style="text-align: center; padding: 10px; color: #2d1b69;">風險</th>';
    html += '<th style="text-align: right; padding: 10px; color: #2d1b69;">?�置?��?</th>';
    html += '<th style="text-align: center; padding: 10px; color: #2d1b69;">比�?</th>';
    html += '</tr>';
    
    allocations.forEach((stock, idx) => {
        const pct = stock.day_change_pct || 0;
        const ratio = (stock.ratio * 100).toFixed(1);
        const riskColor = stock.risk.color;
        
        html += '<tr style="border-bottom: 1px solid #eee;">';
        html += '<td style="padding: 10px;"><strong>' + stock.name + '</strong><br/><span style="font-size: 12px; color: #999;">' + stock.code + '</span></td>';
        html += '<td style="padding: 10px; text-align: center;"><strong style="font-size: 16px; color: #7c3aed;">' + stock.score.toFixed(0) + '</strong></td>';
        html += '<td style="padding: 10px; text-align: center;"><span style="color: ' + riskColor + ';">' + stock.risk.emoji + ' ' + stock.risk.level + '</span></td>';
        html += '<td style="padding: 10px; text-align: right;"><strong>NT$' + stock.allocation.toLocaleString() + '</strong></td>';
        html += '<td style="padding: 10px; text-align: center; color: #666;">' + ratio + '%</td>';
        html += '</tr>';
    });
    
    html += '</table>';
    
    // ?��??�由說�?
    html += '<div style="margin-top: 16px; padding: 12px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 4px;">';
    html += '<div style="font-size: 13px; color: #92400e;"><strong>?? ?��??�輯�?/strong></div>';
    html += '<ul style="margin: 8px 0; padding-left: 20px; font-size: 13px; color: #92400e;">';
    html += '<li>?��? RSI?��?線、支?��??�波?��?等�?標�?算�?資�???/li>';
    html += '<li>評�?越�??�股票�??��?多�???(強勢?��?)</li>';
    html += '<li>?��?計�?風險等�?，幫?��?估頭寸�?�?/li>';
    html += '</ul>';
    html += '</div>';
    
    html += '</div>';
    output.innerHTML = html;
}

function analyzeTrading() {
    const selectEl = document.getElementById("analyzerStockSelect");
    const costPriceInput = document.getElementById("costPrice");
    const output = document.getElementById("tradingAnalysisResult");
    
    if (!output || !selectEl.value) {
        if (output) output.innerHTML = '<div style="padding: 20px; color: red;">請�??��??�票</div>';
        return;
    }
    
    const code = selectEl.value;
    const stock = stocks[code];
    if (!stock) {
        output.innerHTML = '<div style="padding: 20px; color: red;">?��??�股票數??/div>';
        return;
    }
    
    const costPrice = parseFloat(costPriceInput.value);
    if (!costPrice || costPrice <= 0) {
        output.innerHTML = '<div style="padding: 20px; color: red;">請輸?��??��??�本??/div>';
        return;
    }
    
    const currentPrice = stock.current_price || stock.price || 0;
    const profit = currentPrice - costPrice;
    const profitPct = (profit / costPrice) * 100;
    const profitColor = profit >= 0 ? '#ef4444' : '#10b981';
    const profitSymbol = profit >= 0 ? '?? : '??;
    
    // 計�?建議
    let advice = '';
    let adviceColor = '#666';
    const rsi = stock.rsi || 50;
    const price = stock.current_price || 0;
    const ma20 = stock.ma20 || 0;
    const ma50 = stock.ma50 || 0;
    
    if (profit >= 0) {
        // 賺錢?��?
        if (profitPct > 10) {
            advice = '?? ?�利不�?，可?�慮?��??�利了�?';
            adviceColor = '#ef4444';
        } else if (profitPct > 5) {
            advice = '?? ?��??��?漲�?，可觀察�?決�?';
            adviceColor = '#f59e0b';
        } else {
            advice = '??小�??�利，繼續�??��??��??�碼';
            adviceColor = '#10b981';
        }
    } else {
        // ?��??��?
        if (profitPct < -15) {
            advice = '?��? ?��??��?，建議�?賠止??;
            adviceColor = '#ef4444';
        } else if (profitPct < -5) {
            advice = '?��? ?�於?��?，�?待�?彈�??�慮止�?';
            adviceColor = '#f59e0b';
        } else {
            advice = '?��? 小�??��?，可?��?等�??�攤�?;
            adviceColor = '#f59e0b';
        }
    }
    
    // 添�??�術面建議
    if (rsi > 70 && profit > 0) {
        advice += ' (RSI 超買，考慮?�獲??';
    } else if (rsi < 30 && profit < 0) {
        advice += ' (RSI 超賣，可?�慮?�碼?��?)';
    }
    
    // 構建 HTML
    let html = '<div style="padding: 20px; background: #f3e8ff; border-radius: 8px;">';
    html += '<h4 style="margin-bottom: 16px; color: #2d1b69;">買賣試�?結�?</h4>';
    
    // ?�本信息
    html += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">';
    html += '<div style="padding: 12px; background: white; border-radius: 6px;">';
    html += '<div style="font-size: 12px; color: #999; margin-bottom: 4px;">?�本??/div>';
    html += '<div style="font-size: 20px; font-weight: bold; color: #2d1b69;">NT$' + costPrice.toFixed(2) + '</div>';
    html += '</div>';
    html += '<div style="padding: 12px; background: white; border-radius: 6px;">';
    html += '<div style="font-size: 12px; color: #999; margin-bottom: 4px;">?�價</div>';
    html += '<div style="font-size: 20px; font-weight: bold; color: #2d1b69;">NT$' + currentPrice.toFixed(2) + '</div>';
    html += '</div>';
    html += '</div>';
    
    // ?��?
    html += '<div style="padding: 16px; background: white; border-radius: 6px; margin-bottom: 16px;">';
    html += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">';
    html += '<div>';
    html += '<div style="font-size: 12px; color: #999; margin-bottom: 4px;">?��??��?</div>';
    html += '<div style="font-size: 24px; font-weight: bold; color: ' + profitColor + ';">' + profitSymbol + ' NT$' + Math.abs(profit).toFixed(2) + '</div>';
    html += '</div>';
