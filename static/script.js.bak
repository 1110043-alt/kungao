document.addEventListener("DOMContentLoaded", () => {
    const analyzerTab = document.querySelector('[data-tab="analyzer"]');
    if (analyzerTab) {
        analyzerTab.addEventListener("click", () => {
            const selectEl = document.getElementById("analyzerStockSelect");
            if (selectEl && selectEl.value) {
                const code = selectEl.value;
                const stock = stocks[code];
                if (stock) {
                    const currentPrice = stock.current_price || stock.price || 0;
                    const priceDisplay = document.getElementById("currentPriceDisplay");
                    if (priceDisplay) {
                        const change = stock.day_change_pct || 0;
