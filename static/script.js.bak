        htmlMarkup += '<div style="padding: 16px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(168, 85, 247, 0.06)); border: 1px solid #e9d5ff; border-radius: 10px; transition: all 0.2s; cursor: default;" onclick="' + onclick_handler + '">';
        htmlMarkup += '<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">';
        htmlMarkup += '<strong style="font-size: 16px; font-weight: 800; color: #2d1b69;">' + stock.name + '</strong>';
        htmlMarkup += '<span style="font-size: 12px; font-weight: 900; background: rgba(0,0,0,0.1); color: ' + rankColor + '; padding: 3px 8px; border-radius: 4px;">TOP ' + (index + 1) + '</span>';
        htmlMarkup += '</div>';
        htmlMarkup += '<div>';
