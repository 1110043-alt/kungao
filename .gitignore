# 查看 .gitignore 當前內容
Write-Host "=== 檢查 .gitignore ===" -ForegroundColor Cyan
Get-Content .gitignore -ErrorAction SilentlyContinue | Select-Object -First 10

Write-Host ""
Write-Host "=== 移除敏感文件 ===" -ForegroundColor Yellow

# 從 git 中移除 credentials.json (不刪除本地文件)
git rm --cached credentials.json 2>&1 | Select-String -Pattern "(remove|rm-ed)" -ErrorAction SilentlyContinue
if (1 -eq 0) { Write-Host "✓ credentials.json 已從 Git 移除" -ForegroundColor Green }

# 從 git 中移除 cloudflared.exe (如果存在)
git rm --cached cloudflared.exe 2>&1 | Select-String -Pattern "(remove|rm-ed)" -ErrorAction SilentlyContinue

Write-Host ""
Write-Host "=== 添加到 .gitignore ===" -ForegroundColor Yellow

# 添加到 .gitignore
@"
